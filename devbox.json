{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.3/.schema/devbox.schema.json",
  "packages": ["uv@latest"],
  "shell": {
    "init_hook": ["cd pokecoach-trainer 2>/dev/null || true"],
    "scripts": {
      "setup-vendor": ["bash scripts/sync_vgc_bench.sh"],
      "setup": [
        "bash scripts/sync_vgc_bench.sh",
        "cd pokecoach-trainer && uv sync --locked --all-extras"
      ],
      "start": [
        "cd pokecoach-trainer && uv run --locked uvicorn pokecoach_trainer.main:app --host 127.0.0.1 --port 8010 --workers 1"
      ],
      "test": ["cd pokecoach-trainer && uv run --locked pytest"],
      "check": ["cd pokecoach-trainer && uv run --locked ruff check src tests"],
      "cli": ["cd pokecoach-trainer && uv run --locked pokecoach-trainer \"$@\""],
      "build": ["cd pokecoach-trainer && uv build"],
      "reload-check": [
        "cd pokecoach-trainer && uv run --locked python -m pokecoach_trainer.reload_check"
      ]
    }
  }
}
